  "browserFlow": "browser-step-up",
  "authenticationFlows": [
    {
      "alias": "browser-step-up",
      "description": "Browser flow with levels of authentication: LoA1 password, LoA2 password + TOTP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "browser-step-up-forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-step-up-forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "flowAlias": "loa1-password",
          "requirement": "CONDITIONAL",
          "priority": 10,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "loa2-otp",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "loa1-password",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "loa1-condition",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "loa2-otp",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "loa2-condition",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "reset-credentials-verified",
      "description": "Password recovery: email link, then VERIFY the existing TOTP (never reset it), then new password",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "reset-credentials-choose-user",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "reset-credential-email",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "reset-credentials-verified-otp",
          "requirement": "CONDITIONAL",
          "priority": 30,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        },
        {
          "authenticator": "reset-password",
          "requirement": "REQUIRED",
          "priority": 40,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "reset-credentials-verified-otp",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "loa1-condition",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "loa2-condition",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "300"
      }
    }
  ],
  "attributes": {
    "acr.loa.map": "{\"1\": 1, \"2\": 2}"
  },
  "loginTheme": "nicebank",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "es",
    "pt-BR",
    "en"
  ],
  "defaultLocale": "es",
  "resetPasswordAllowed": true,
  "emailTheme": "nicebank",
  "passwordPolicy": "length(8) and upperCase(1) and lowerCase(1) and digits(1) and notUsername",
  "actionTokenGeneratedByUserLifespan": 600,
  "smtpServer": {
    "host": "${KC_SMTP_HOST:mailpit}",
    "port": "${KC_SMTP_PORT:1025}",
    "from": "${KC_SMTP_FROM:nicebank@evon.solutions}",
    "fromDisplayName": "NiceBank",
    "envelopeFrom": "${KC_SMTP_ENVELOPE_FROM:}",
    "replyTo": "",
    "ssl": "${KC_SMTP_SSL:false}",
    "starttls": "false",
    "auth": "${KC_SMTP_AUTH:false}",
    "user": "${KC_SMTP_USER:}",
    "password": "${KC_SMTP_PASSWORD:}"
  },
  "resetCredentialsFlow": "reset-credentials-verified"
}
