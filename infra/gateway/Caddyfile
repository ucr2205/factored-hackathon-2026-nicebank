# NiceBank gateway: one public entry point, routed by path.
#   /            the web app            /api/*        the backend API (Swagger at /api/docs)
#   /jaeger/     traces                 /prometheus/  metrics, rules and alerts
#   /mail/       Mailpit (local mail catcher)
# The three tools have no login of their own, so the gateway asks for a username and password first
# (TOOLS_USER / TOOLS_PASSWORD_HASH, generated by `make env`; the hash is bcrypt, the password stays in .env).
#
# SITE_ADDRESS: ":80" locally (published on http://localhost:8090). In a deployment set it to the public domain
# (e.g. nicebank.example.com) and publish ports 80/443: Caddy then obtains and renews the HTTPS certificate itself.
{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	@tools path /jaeger /jaeger/* /prometheus /prometheus/* /mail /mail/*
	basic_auth @tools {
		{$TOOLS_USER:equipo} {$TOOLS_PASSWORD_HASH}
	}

	# Each tool is configured to live under its own path (QUERY_BASE_PATH, --web.route-prefix, MP_WEBROOT),
	# so requests are proxied as they are, without rewriting.
	redir /jaeger /jaeger/
	redir /prometheus /prometheus/
	redir /mail /mail/
	handle /jaeger/* {
		reverse_proxy jaeger:16686
	}
	handle /prometheus/* {
		reverse_proxy prometheus:9090
	}
	handle /mail/* {
		reverse_proxy mailpit:8025
	}

	# The backend's /metrics is internal (Prometheus scrapes it directly) and is not routed here.
	handle /api/* {
		reverse_proxy backend:8081
	}
	handle {
		reverse_proxy frontend:80
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
