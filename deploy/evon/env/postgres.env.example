# Copiar a: /mnt/EVON_proyectos_env/EVON/nicebank/postgres/.env   (chmod 600)
# Lo leen la imagen de Postgres y los scripts de infra/postgres/init SOLO al crear la BD por primera vez.
# Cambiar contraseñas aquí después no las cambia en la BD (habría que usar ALTER ROLE).

# Superusuario y dueño del esquema (lo usa la carga de datos; la app NUNCA se conecta con él)
POSTGRES_USER=nicebank_admin
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_ADMIN
POSTGRES_DB=nicebank

# Usuario de la aplicación (sin BYPASSRLS): el mismo de DATABASE_URL en backend/.env
APP_DB_USER=nicebank_app
APP_DB_PASSWORD=CAMBIAR_PASSWORD_APP

# Usuario de Keycloak: el mismo de KC_DB_USERNAME / KC_DB_PASSWORD en keycloak/.env
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CAMBIAR_PASSWORD_KEYCLOAK
