# Copiar a: /mnt/EVON_proyectos_env/EVON/nicebank/backend/.env   (chmod 600)
# Las URLs públicas, puertos y CORS están en el docker-compose.yaml; aquí solo secretos y ajustes.

# --- Base de datos (contenedor nicebank-postgres) ---
# Usuario de APLICACIÓN (APP_DB_USER de postgres/.env, sin BYPASSRLS), NUNCA el admin: la seguridad por filas depende de esto.
DATABASE_URL=postgres://nicebank_app:CAMBIAR_PASSWORD_APP@nicebank-postgres:5432/nicebank?sslmode=disable

# --- Cifrado de identidad de clientes ---
# DEBE ser la MISMA clave con la que se cargaron los datos (make seed). Si no coincide, no se descifran los nombres.
PII_KEY=CAMBIAR_base64_de_32_bytes

# --- LLM ---
# fake = determinista y offline; deepseek = modelo real (requiere API key)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=CAMBIAR
LLM_MODEL=deepseek-flash
LLM_FALLBACK_MODEL=deepseek-v4-pro
LLM_COMPOSE=template

# --- Fecha "hoy" del demo (fin del dataset sintético) ---
DEMO_TODAY=2026-06-17

# --- Correo (notificaciones) ---
NOTIFY_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURITY=ssl
EMAIL_USERNAME=CAMBIAR
EMAIL_PASSWORD=CAMBIAR
MAIL_FROM=nicebank@evon.solutions
MAIL_FROM_NAME=NiceBank
# OBLIGATORIO con servidor real: todos los correos van a este buzón de pruebas
# (los datos demo tienen direcciones de apariencia real).
MAIL_REDIRECT_TO=CAMBIAR_buzon_de_pruebas@evon.solutions
MAIL_BCC=
MAIL_ALLOW_REAL_RECIPIENTS=false

# --- Logs ---
LOG_LEVEL=info
LOG_FORMAT=json
