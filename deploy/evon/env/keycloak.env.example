# Copiar a: /mnt/EVON_proyectos_env/EVON/nicebank/keycloak/.env   (chmod 600)

# --- BD propia de Keycloak en nicebank-postgres (creada por 03_keycloak_db.sh) ---
KC_DB_URL=jdbc:postgresql://nicebank-postgres:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=CAMBIAR_PASSWORD_KEYCLOAK

# --- Admin inicial (solo se usa la primera vez; luego cambiarla desde la consola) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CAMBIAR

# --- SMTP para correos de recuperación de contraseña (se leen al IMPORTAR el realm) ---
KC_SMTP_HOST=mail.netnovation.com
KC_SMTP_PORT=465
KC_SMTP_FROM=nicebank@evon.solutions
KC_SMTP_ENVELOPE_FROM=CAMBIAR_mismo_que_usuario
KC_SMTP_USER=CAMBIAR
KC_SMTP_PASSWORD=CAMBIAR
KC_SMTP_SSL=true
KC_SMTP_AUTH=true
# El usuario demo cliente20 (recuperación de contraseña) recibe en este buzón:
KC_DEMO_RESET_EMAIL=CAMBIAR_buzon_de_pruebas@evon.solutions
