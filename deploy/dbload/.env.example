# Copy to .env (next to load_db.py) or export these variables. Never commit the real .env.

# Postgres server. DB_ADMIN_USER must be the database owner: a superuser or a role with BYPASSRLS
# (in the NiceBank container, the POSTGRES_USER of postgres/.env, e.g. nicebank_admin).
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=nicebank
DB_ADMIN_USER=nicebank_admin
DB_ADMIN_PASSWORD=CAMBIAR
DB_SSLMODE=prefer

# Application role the backend connects with (no superuser, no BYPASSRLS). Created if missing.
# Must match DATABASE_URL in the backend .env.
APP_DB_USER=nicebank_app
APP_DB_PASSWORD=CAMBIAR

# The key the bundle was built with (the developer's PII_KEY). The script checks it decrypts the names.
PII_KEY=CAMBIAR_base64_de_32_bytes

# Logs: console level and a file next to the script (empty LOG_FILE disables the file).
LOG_LEVEL=INFO
LOG_FILE=load_db.log
