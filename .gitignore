# --- Data: never commit (datathon data-use terms) ---
data/
*.duckdb
*.duckdb.wal
*.parquet

# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Organizer documents (they contain credentials) ---
*.pdf
!docs/pitch/*.pdf

# --- ML ---
# ml/data/ holds the corpus generator (code, committed); its build/ output includes masked transcript text.
!ml/data/
ml/data/build/
ml/mlruns/
ml/models/
*.joblib

# --- Python ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# --- Node / frontend ---
node_modules/
frontend/dist/

# --- Go ---
backend/bin/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Local analysis outputs (regenerated by scripts) ---
analysis/out/
eval/reports/*.json

# --- Team-internal material (Spanish, not part of the public repo) ---
team/

# --- Load-test outputs (regenerated by JMeter) ---
qa/jmeter/results/

# Local AI tooling registry (machine-specific paths)
.atl/

# Obsidian: per-user layout and cache (the vault itself is shared)
vault/.obsidian/workspace*.json
vault/.obsidian/cache
vault/.trash/
