# Copy to .env (git-ignored) and adjust. NEVER commit .env.

# --- AWS (read-only dataset) ---
# Keys do NOT go here: configure them with `aws configure --profile factored`.
AWS_PROFILE=factored
AWS_REGION=us-east-2
DATA_BUCKET=factored-datathon-2026-s3-157725502942-us-east-2-an

# --- Postgres (local development values) ---
POSTGRES_USER=bank_admin
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=bank
POSTGRES_PORT=5433   # host port of the compose Postgres
APP_DB_USER=app_user
APP_DB_PASSWORD=change-me-app

# --- Keycloak (local development admin) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-kc

# --- Customer identity encryption ---
# Generated by `make env` (random, local only). Encrypts names in customer_identity; `make seed` uses it too.
# PII_KEY=

# --- Email notifications (case opened, card blocked, handoff) ---
# Default: local Mailpit (http://localhost:8025), nothing leaves your machine.
# Real server (Netnovation mail, SSL 465): uncomment and put the account ONLY in your local .env.
# SMTP_HOST=mail.netnovation.com       # same server the blueprint project uses for blue@evon.solutions
# SMTP_PORT=465
# SMTP_SECURITY=ssl
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# MAIL_FROM=nicebank@evon.solutions      # visible alias; the server must allow EMAIL_USERNAME to send as it
# MAIL_REDIRECT_TO=                      # REQUIRED with a real server: every email goes to this test inbox,
#                                        # because the demo data has realistic-looking customer addresses
# MAIL_BCC=
NOTIFY_ENABLED=true

# --- Backend logs and API docs ---
LOG_LEVEL=info            # debug shows health/metrics probes too
LOG_FORMAT=json           # json (one object per line) | text (easier to read locally)
TRUSTED_PROXIES=          # CIDRs of reverse proxies whose X-Forwarded-For is trusted; empty = none
DOCS_ENABLED=true         # Swagger UI at http://localhost:8081/api/docs (turn off in production)

# --- LLM ---
# fake = deterministic, free, offline (default; tests and CI). deepseek = real model via api.deepseek.com.
LLM_PROVIDER=fake
# DEEPSEEK_API_KEY=    <- paste it ONLY in your local .env, never here
LLM_MODEL=deepseek-flash          # DeepSeek V4.1 Flash (the old name deepseek-v4-flash is an alias)
LLM_FALLBACK_MODEL=deepseek-v4-pro # second attempt when the primary fails or returns invalid JSON
LLM_COMPOSE=template              # template = reviewed replies; ai = model rewording, kept only if every fact survives
