# NiceBank — local configuration template.
#
#   cp .env.example .env      (or: make env, which also generates PII_KEY and the tools login)
#
# .env is git-ignored: NEVER commit it. Every value below is a safe local default; the only things you must add
# yourself are secrets you own (DeepSeek key, a real SMTP account), and only in your local .env.
# Lines starting with "#" are optional; the default in docker-compose.yml applies when a variable is unset.

# ----------------------------------------------------------------------------------------------------------------
# Dataset (read-only S3 bucket from the organizers) — used by `make data`
# Credentials do NOT go here: run `aws configure --profile factored` (or `aws login`).
# ----------------------------------------------------------------------------------------------------------------
AWS_PROFILE=factored
AWS_REGION=us-east-2
DATA_BUCKET=factored-datathon-2026-s3-157725502942-us-east-2-an

# ----------------------------------------------------------------------------------------------------------------
# PostgreSQL (+ pgvector) — local development only
# The API connects as APP_DB_USER, a non-owner role subject to row-level security.
# ----------------------------------------------------------------------------------------------------------------
POSTGRES_USER=bank_admin
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=bank
POSTGRES_PORT=5433            # host port (the container listens on 5432)
APP_DB_USER=app_user
APP_DB_PASSWORD=change-me-app

# ----------------------------------------------------------------------------------------------------------------
# Keycloak — local admin console (http://localhost:8080). Test users come from infra/keycloak/latam-bank-realm.json.
# ----------------------------------------------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-kc

# ----------------------------------------------------------------------------------------------------------------
# Customer identity encryption (AES-GCM, 32 random bytes in base64)
# Generated by `make env`. Encrypts names and contact emails in customer_identity; `make seed` encrypts with it.
# A server and its database must share the same key (deploy/dbload checks it before loading).
# ----------------------------------------------------------------------------------------------------------------
# PII_KEY=

# ----------------------------------------------------------------------------------------------------------------
# Backend
# ----------------------------------------------------------------------------------------------------------------
LOG_LEVEL=info                # debug also logs health and metrics probes
LOG_FORMAT=json               # json (one object per line) | text (easier to read locally)
TRUSTED_PROXIES=              # CIDRs of reverse proxies whose X-Forwarded-For is trusted; empty = none
DOCS_ENABLED=true             # Swagger UI at http://localhost:8081/api/docs (turn off in production)
# DEMO_TODAY=2026-06-17       # "today" for the synthetic data, which ends on this date

# ----------------------------------------------------------------------------------------------------------------
# Language model
# fake     = deterministic, free and offline (default; tests and CI)
# deepseek = DeepSeek API; receives masked text only (names, emails and numbers are replaced before the call)
# ----------------------------------------------------------------------------------------------------------------
LLM_PROVIDER=fake
# DEEPSEEK_API_KEY=           # secret: only in your local .env
LLM_MODEL=deepseek-flash
LLM_FALLBACK_MODEL=deepseek-v4-pro   # second attempt when the primary fails or returns invalid JSON
LLM_COMPOSE=template          # template = reviewed replies (recommended); ai = model rewording, kept only if every fact survives

# ----------------------------------------------------------------------------------------------------------------
# Email notifications (dispute opened, card blocked, case with a specialist)
# Default: local Mailpit (http://localhost:8025/mail) — nothing leaves your machine.
# Real SMTP server: uncomment, and put the account only in your local .env. MAIL_REDIRECT_TO is then REQUIRED:
# the synthetic customers have realistic-looking addresses, so every email goes to that one test inbox instead.
# ----------------------------------------------------------------------------------------------------------------
NOTIFY_ENABLED=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl           # ssl (465) | starttls (587) | none (Mailpit)
# EMAIL_USERNAME=
# EMAIL_PASSWORD=             # secret
# MAIL_FROM=nicebank@example.com   # visible sender; the server must allow EMAIL_USERNAME to send as it
# MAIL_FROM_NAME=NiceBank
# MAIL_REDIRECT_TO=           # required with a real server
# MAIL_BCC=
# MAIL_APP_URL=http://localhost:8088/chat   # the "view my case" link inside the emails
# MAIL_ALLOW_REAL_RECIPIENTS=false          # true only for real customers; never with the synthetic dataset

# ----------------------------------------------------------------------------------------------------------------
# Gateway (Caddy, infra/gateway/Caddyfile): one entry point with the app at /, the API at /api, and Jaeger,
# Prometheus and Mailpit at /jaeger, /prometheus and /mail behind a team login.
# `make env` fills TOOLS_USER, TOOLS_PASSWORD (readable, for the team) and TOOLS_PASSWORD_HASH (bcrypt, for Caddy).
# ----------------------------------------------------------------------------------------------------------------
TOOLS_USER=
TOOLS_PASSWORD=
TOOLS_PASSWORD_HASH=
# GATEWAY_PORT=8090
# Public deployment only: the domain (Caddy then obtains HTTPS itself; publish ports 80/443) and its https origin.
SITE_ADDRESS=
PUBLIC_URL=
